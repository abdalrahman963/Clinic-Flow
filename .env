# Copy this file to .env and replace the values with your own.
#   cp .env.example .env       (macOS / Linux)
#   Copy-Item .env.example .env  (Windows PowerShell)
#
# Then put YOUR local machine IP / Laravel server URL here.
# Examples:
#   BASE_URL=http://192.168.1.100:8000/api
#   BASE_URL=http://10.0.2.2:8000/api          # Android emulator -> host machine
#   BASE_URL=https://your-staging-domain.com/api

BASE_URL=http://192.168.1.34:8000/api
